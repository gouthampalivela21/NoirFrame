# =========================================================================
# PHANTOM LABS — ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Secure First-Run Founder Setup & JWT Signing
# One-time server setup secret required to create the initial Founder account at /admin/login.
# Prevents unauthorized visitors from claiming Founder access on first run.
FOUNDER_SETUP_SECRET=replace_with_a_strong_random_setup_secret

# Optional: Pin the initial Founder account to a specific email address.
# Leave unset to enter your Founder email interactively during first-run setup.
# FOUNDER_EMAIL=you@yourdomain.com

# Secret key used on the server to sign and verify HMAC-SHA256 session JWTs
ADMIN_JWT_SECRET=replace_with_a_long_random_jwt_secret_key

# 2. Supabase Cloud Database (Optional persistent remote cloud backend)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon/public
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: Supabase Service Role Key for server-side elevated access
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Optional: Production Site URL (For OAuth redirects)
# VITE_SITE_URL=https://phantomlabs.in
