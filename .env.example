# =========================================================================
# PHANTOM LABS STUDIO OS — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# 1. Public Firebase Web Configuration (Safe for client-side bundle)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# 2. Strict Single-Owner Security Credentials
# Copy your exact Firebase Auth UID from Firebase Console -> Authentication -> Users
VITE_ADMIN_UID=YOUR_EXACT_FIREBASE_UID
# The single Google account allowed to access the admin panel
VITE_ADMIN_EMAIL=your-founder-google-account@example.com

# 3. Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Safe for browser use (the value starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# 4. Strictly Server-Side Secrets (NEVER prefix with VITE_ or expose in client code)
# Secret API key for server use only (the value starts with sb_secret_)
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Must match VITE_ADMIN_EMAIL; keep this server-side value out of the browser bundle.
FOUNDER_EMAIL=your-founder-google-account@example.com
