# =========================================================================
# PHANTOM LABS — ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Publishable Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon/public
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 3. Optional: Production Site URL (For OAuth redirects in SSR / Staging)
# Defaults dynamically to window.location.origin
# VITE_SITE_URL=https://phantomlabs.in

